{
  "name": "godot4-rust",
  "displayName": "Godot4 Rust",
  "publisher": "jgirardet",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0",
    "node": "^20.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jgirardet/godot4-rust"
  },
  "activationEvents": [
    "workspaceContains:Cargo.toml",
    "workspaceContains:*/Cargo.toml"
  ],
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "treeViewActiveItem"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "godot4-rust",
          "name": "Godot4 Rust"
        }
      ]
    },
    "commands": [
      {
        "command": "godot4-rust.setGodotProject",
        "title": "Godot4-Rust: Set Godot Project"
      },
      {
        "command": "godot4-rust.insertOnReady",
        "title": "Godot4-Rust: Insert OnReady field",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.newGodotClass",
        "title": "Godot4-Rust: Create a new GodotClass from Godot Scene",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.createGdextension",
        "title": "Godot4-Rust: Create a the .gdextension file in your project",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.startNewGDExtensionProject",
        "title": "Godot4-Rust: Start a new GDExtension project",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.reveal",
        "title": "Godot4-Rust: Reveal current class in panel",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.refresh",
        "title": "Godot4-Rust: Refresh panel",
        "enablement": "godot4-rust.project_set"
      },
      {
        "command": "godot4-rust.replaceBaseClass",
        "title": "Godot4-Rust: Change Type with GodotClass in active Editor",
        "enablement": "godot4-rust.project_set"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "godot4-rust.refresh",
          "when": "godot4-rust.project_set",
          "group": "inline"
        }
      ],
      "view/item/context": [
        {
          "when": "view == godot4-rust && viewItem =~ /^root$/",
          "command": "godot4-rust.newGodotClass"
        },
        {
          "when": "view == godot4-rust && viewItem =~ /^root/ && editorIsOpen",
          "command": "godot4-rust.replaceBaseClass"
        },
        {
          "when": "view == godot4-rust && viewItem =~ /^child$/",
          "command": "godot4-rust.insertOnReady"
        }
      ]
    },
    "configuration": {
      "title": "Godot4 Rust",
      "properties": {
        "godot4-rust.godotProjectFilePath": {
          "description": "The path to .godot project file",
          "type": "string",
          "default": null
        },
        "godot4-rust.autoReplaceInTscn": {
          "description": "Auto replace Root Godot Node by Rust Godoclass after a new godotclass is generated",
          "type": "boolean",
          "default": false
        },
        "godot4-rust.nbWorkersToParseTscn": {
          "description": "Fixed Number of workers to parse tscn files. Should not be set in most cases",
          "type": "number",
          "default": 0
        },
        "godot4-rust.newGodotClassDefaultVisibility": {
          "description": "New Godot-class default visibility",
          "type": "string",
          "enum": [
            "",
            "pub",
            "pub(crate)",
            "pub(super)"
          ],
          "default": "pub"
        },
        "godot4-rust.newGodotClassAutoInsertMod": {
          "description": "How to insert (or not) `mod` in lib.rs or mod.rs (needs Rust-Analyzer)",
          "type": "string",
          "enum": [
            "",
            "mod",
            "pub mod",
            "pub(crate) mod"
          ],
          "default": "mod"
        }
      }
    }
  },
  "watch": {
    "ui-vsix": {
      "patterns": [
        "out",
        "scripts/out"
      ],
      "extensions": "js,mjs",
      "runOnChangeOnly": false,
      "quiet": false,
      "silent": false,
      "ignore": "out/test",
      "inherits": true
    }
  },
  "scripts": {
    "setup": "npm run cloneScal && npm run fixSelenium",
    "fnm": "fnm use 20",
    "watch_vsix": "npm-watch ui-vsix",
    "cloneScal": "git clone https://github.com/nicolasbize/Scalazard assets/scalazar",
    "fixSelenium": "sed -i '1s/^/import { WebSocket } from \\\"ws\\\";\\\n/' node_modules/@types/selenium-webdriver/bidi/index.d.ts",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "compileScripts": "tsc -p scripts/tsconfig.json",
    "buildGodotClasses": "node scripts/out/buildGodotClasses.js",
    "manage": "node ./scripts/out/manage.js",
    "unit-test": "mocha out/test/unit",
    "vscode-test": "node out/test/vscode/runTests.js",
    "ui-install-dep": "extest install-from-marketplace -e .test-extensions rust-lang.rust-analyzer",
    "ui-setup-extest": "extest setup-tests -e .test-extensions",
    "ui-setup": "npm run ui-setup-extest && npm run ui-install-dep",
    "ui-vsix": "extest install-vsix -e .test-extensions",
    "ui-test": "extest run-tests './out/test/ui/*.test.mjs' -o src/test/ui/settings.json -e .test-extensions",
    "ui-testone": "extest run-tests -o src/test/ui/settings.json -e .test-extensions -f"
  },
  "devDependencies": {
    "@mitata/counters": "^0.0.8",
    "@types/find-parent-dir": "^0.3.3",
    "@types/ini": "^4.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.99.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "cheerio": "^1.0.0",
    "earl": "^1.3.0",
    "eslint": "^9.25.1",
    "mitata": "^1.0.34",
    "npm-watch": "^0.13.0",
    "typescript": "^5.8.3",
    "vscode-extension-tester": "^8.14.1"
  },
  "dependencies": {
    "fastest-levenshtein": "^1.0.16",
    "find-parent-dir": "^0.3.1",
    "fs": "^0.0.1-security",
    "glob": "^11.0.2",
    "ini": "^5.0.0",
    "piscina": "^5.0.0",
    "smol-toml": "^1.3.4",
    "string-ts": "^2.2.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-godot-resource": "git+https://git@github.com/jgirardet/tree-sitter-godot-resource.git#peerDep",
    "tree-sitter-rust": "^0.24.0",
    "ts-case-convert": "^2.1.0",
    "tscn2json": "^1.0.0",
    "winston": "^3.17.0",
    "winston-transport-vscode": "^0.1.0"
  }
}